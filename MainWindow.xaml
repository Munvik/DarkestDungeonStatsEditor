<Window x:Class="DDStatsMod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darkest Dungeon Stats Mod Tool"
        Height="750" Width="1100"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Lewy panel -->
        <StackPanel Grid.Column="0" Background="#252526" Margin="10">
            <TextBlock Text="Bohaterowie" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="HeroesList"
                     Height="400"
                     Background="#333"
                     Foreground="White"
                     SelectionChanged="HeroesList_SelectionChanged"/>

            <Separator Margin="0,10,0,10"/>

            <Button x:Name="LoadFilesButton"
                    Content="Wczytaj pliki"
                    Margin="0,5,0,0"
                    Padding="5"
                    Click="LoadFiles_Click"/>

            <Button x:Name="SaveFileButton"
                    Content="Zapisz zmiany"
                    Margin="0,5,0,0"
                    Padding="5"
                    Click="SaveFile_Click"/>

            <Separator Margin="0,15,0,10"/>

            <TextBlock Text="Modyfikacja globalna (%)" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PercentBox"
                         Width="60"
                         Text="10"
                         HorizontalContentAlignment="Center"/>
                <Button x:Name="ApplyPercentAllButton"
                        Content="Zastosuj %"
                        Margin="5,0,0,0"
                        Padding="5"
                        Click="ApplyPercentAll_Click"/>
            </StackPanel>

            <!-- Checkboxy globalne -->
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="ApplyWeaponsCheck" IsChecked="True" Content="Zastosuj do broni" Margin="0,2,0,0"/>
                <CheckBox x:Name="ApplyArmoursCheck" IsChecked="True" Content="Zastosuj do zbroi" Margin="0,2,0,0"/>
                <CheckBox x:Name="ApplyAllHeroesCheck" IsChecked="True" Content="Zastosuj do wszystkich postaci" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Prawy panel -->
        <Grid Grid.Column="1" Margin="10">
            <TabControl x:Name="HeroTabs">

                <!-- WEAPONS -->
                <TabItem Header="Weapons">
                    <DockPanel Background="#1E1E1E">
                        <DataGrid x:Name="WeaponsGrid"
                  ItemsSource="{Binding SelectedWeapons}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  RowBackground="#2b2b2b"
                  AlternatingRowBackground="#1f1f1f"
                  Foreground="#f0f0f0"
                  Background="#1e1e1e"
                  BorderBrush="#3c3c3c"
                  BorderThickness="1"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="#3c3c3c"
                  VerticalGridLinesBrush="#3c3c3c"
                  FontSize="13"
                  Margin="5"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  DockPanel.Dock="Top"
                  Height="550">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333" />
                                    <Setter Property="Foreground" Value="#ddd" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="BorderBrush" Value="#444" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Dmg Min" Binding="{Binding DmgMin}" Width="80" />
                                <DataGridTextColumn Header="Dmg Max" Binding="{Binding DmgMax}" Width="80" />
                                <DataGridTextColumn Header="Crit" Binding="{Binding Crit}" Width="60" />
                                <DataGridTextColumn Header="Spd" Binding="{Binding Spd}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Zakładkowe opcje -->
                        <Border DockPanel.Dock="Bottom" Background="#252526" Padding="10" Margin="10,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Zakładkowe opcje" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="WeaponPercentBox" Width="60" Text="10" HorizontalContentAlignment="Center"/>
                                    <Button Content="Zastosuj" Margin="5,0,10,0" Padding="5" Click="ApplyWeaponTabPercent_Click"/>
                                    <CheckBox x:Name="ApplyDamageCheck" IsChecked="True" Content="Damage" Margin="0,0,5,0"/>
                                    <CheckBox x:Name="ApplyCritCheck" IsChecked="True" Content="Crit" Margin="0,0,5,0"/>
                                    <CheckBox x:Name="ApplySpeedCheck" IsChecked="True" Content="Speed" Margin="0,0,5,0"/>
                                    <CheckBox x:Name="ChkWeaponsFromOriginal" IsChecked="True" Content="Od wartości oryginalnej" Margin="15,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </TabItem>

                <!-- ARMOUR -->
                <TabItem Header="Armour">
                    <DockPanel Background="#1E1E1E">
                        <DataGrid x:Name="ArmoursGrid"
                  ItemsSource="{Binding SelectedArmours}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  RowBackground="#2b2b2b"
                  AlternatingRowBackground="#1f1f1f"
                  Foreground="#f0f0f0"
                  Background="#1e1e1e"
                  BorderBrush="#3c3c3c"
                  BorderThickness="1"
                  HeadersVisibility="Column"
                  HorizontalGridLinesBrush="#3c3c3c"
                  VerticalGridLinesBrush="#3c3c3c"
                  FontSize="13"
                  Margin="5"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  DockPanel.Dock="Top"
                  Height="550">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333" />
                                    <Setter Property="Foreground" Value="#ddd" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="BorderBrush" Value="#444" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="80" />
                                <DataGridTextColumn Header="Prot" Binding="{Binding Prot}" Width="80" />
                                <DataGridTextColumn Header="Hp" Binding="{Binding Hp}" Width="80" />
                                <DataGridTextColumn Header="Spd" Binding="{Binding Spd}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border DockPanel.Dock="Bottom" Background="#252526" Padding="10" Margin="10,0,10,10">
                            <StackPanel>
                                <TextBlock Text="Zakładkowe opcje" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ArmourPercentBox" Width="60" Text="10" HorizontalContentAlignment="Center"/>
                                    <Button Content="Zastosuj" Margin="5,0,10,0" Padding="5" Click="ApplyArmourTabPercent_Click"/>
                                    <CheckBox x:Name="ApplyHpCheck" IsChecked="True" Content="Hp" Margin="0,0,5,0"/>
                                    <CheckBox x:Name="ApplyDefCheck" IsChecked="True" Content="Def" Margin="0,0,5,0"/>
                                    <CheckBox x:Name="ChkArmoursFromOriginal" IsChecked="True" Content="Od wartości oryginalnej" Margin="15,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </TabItem>


            </TabControl>
        </Grid>
    </Grid>
</Window>
