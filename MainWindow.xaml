<Window x:Class="DDStatsMod.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darkest Dungeon Stats Mod Tool"
        SizeToContent="Height"
        Width="1100"
        Background="#1E1E1E"
        Foreground="White">

    <Window.Resources>
        <!-- Style for "From original value" -->
        <Style x:Key="GoldenCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Border"
                            Width="18" Height="18"
                            CornerRadius="3"
                            BorderBrush="#FFD700"
                            BorderThickness="2"
                            Background="#333"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                              Data="M0,4 L3,8 L8,0"
                              Stroke="#FFD700"
                              StrokeThickness="2"
                              Visibility="Collapsed"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Border" Property="Background" Value="#FFD700"/>
                                <Setter TargetName="CheckMark" Property="Stroke" Value="#000"/>
                                <Setter Property="Foreground" Value="#000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <StackPanel Grid.Column="0" Background="#252526" Margin="10">
            <TextBlock Text="Heroes" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#FFD700"/>
            <ListBox x:Name="HeroesList"
                     Height="400"
                     Background="#333"
                     Foreground="White"
                     BorderBrush="#444"
                     BorderThickness="1"
                     SelectionChanged="HeroesList_SelectionChanged"/>

            <Separator Margin="0,10,0,10" Background="#555"/>

            <Button x:Name="LoadFilesButton"
                    Content="📂 Load files"
                    Margin="0,5,0,0"
                    Padding="6"
                    Background="#444"
                    Foreground="White"
                    BorderBrush="#777"
                    Click="LoadFiles_Click"/>

            <Button x:Name="LoadFolderButton"
                    Content="Load character folder"
                    Margin="0,5,0,0"
                    Padding="5"
                    Click="LoadFolderButton_Click"/>


            <Button x:Name="SaveFileButton"
                    Content="💾 Save changes"
                    Margin="0,5,0,0"
                    Padding="6"
                    Background="#444"
                    Foreground="White"
                    BorderBrush="#777"
                    Click="SaveFile_Click"/>

            <Separator Margin="0,15,0,10" Background="#555"/>

            <TextBlock Text="Global modification (%)" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="PercentBox"
                         Width="60"
                         Text="25"
                         Background="#2d2d2d"
                         Foreground="White"
                         BorderBrush="#555"
                         HorizontalContentAlignment="Center"/>
                <Button x:Name="ApplyPercentAllButton"
                        Content="Apply %"
                        Margin="5,0,0,0"
                        Padding="6"
                        Background="#444"
                        Foreground="White"
                        BorderBrush="#777"
                        Click="ApplyPercentAll_Click"/>
            </StackPanel>

            <!-- Global checkboxes -->
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="ApplyWeaponsCheck" IsChecked="True" Content="Apply to weapon" Margin="0,2,0,0" Foreground="White"/>
                <CheckBox x:Name="ApplyArmoursCheck" IsChecked="True" Content="Apply to armour" Margin="0,2,0,0" Foreground="White"/>
                <CheckBox x:Name="ApplyAllHeroesCheck" IsChecked="True" Content="Apply to all heroes" Margin="0,2,0,0" Foreground="White"/>

                <CheckBox x:Name="ChkGlobalFromOriginal"
                      Content="From original value"
                      IsChecked="True"
                      Margin="20,0,0,0"
                      Foreground="#FFD700"
                      FontWeight="Bold"
                      FontSize="13"/>
            </StackPanel>

            <Separator Margin="0,15,0,10" Background="#555"/>

            <TextBlock Text="Reset values" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ResetButton"
            Content="🔄 Reset"
            Width="100"
            Padding="6"
            Background="#444"
            Foreground="White"
            BorderBrush="#777"
            Click="ResetButton_Click"/>
                <CheckBox x:Name="ResetAllCheck"
                    Content="Reset all"
                    IsChecked="True"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <!-- Right panel -->
        <Grid Grid.Column="1" Margin="10">
            <TabControl x:Name="HeroTabs"
                        Background="#1E1E1E"
                        BorderBrush="#3c3c3c"
                        Foreground="White">

                <!-- WEAPONS -->
                <TabItem Header="Weapon">
                    <DockPanel Background="#1E1E1E">
                        <DataGrid x:Name="WeaponsGrid"
                                  ItemsSource="{Binding SelectedWeapons}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  RowBackground="#2b2b2b"
                                  AlternatingRowBackground="#1f1f1f"
                                  Foreground="#f0f0f0"
                                  Background="#1e1e1e"
                                  BorderBrush="#3c3c3c"
                                  BorderThickness="1"
                                  HeadersVisibility="Column"
                                  HorizontalGridLinesBrush="#3c3c3c"
                                  VerticalGridLinesBrush="#3c3c3c"
                                  FontSize="13"
                                  Margin="5"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  DockPanel.Dock="Top"
                                  Height="520">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333" />
                                    <Setter Property="Foreground" Value="#ddd" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="BorderBrush" Value="#444" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Dmg Min" Binding="{Binding DmgMin}" Width="80" />
                                <DataGridTextColumn Header="Dmg Max" Binding="{Binding DmgMax}" Width="80" />
                                <DataGridTextColumn Header="Crit" Binding="{Binding Crit}" Width="60" />
                                <DataGridTextColumn Header="Spd" Binding="{Binding Spd}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tab options -->
                        <Border DockPanel.Dock="Bottom"
                                Background="#2C2C2C"
                                Padding="12"
                                Margin="10,0,10,10"
                                BorderBrush="#FFD700"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Tab options" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,6" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="WeaponPercentBox" Width="60" Text="25" Background="#2d2d2d" Foreground="White" BorderBrush="#555" HorizontalContentAlignment="Center"/>
                                    <Button Content="Apply %"
                                            Margin="5,0,10,0"
                                            Padding="6"
                                            Background="#444"
                                            Foreground="White"
                                            BorderBrush="#777"
                                            Click="ApplyWeaponTabPercent_Click"/>
                                    <CheckBox x:Name="ApplyDamageCheck" IsChecked="True" Content="Damage" Margin="0,0,5,0" Foreground="White"/>
                                    <CheckBox x:Name="ApplyCritCheck" IsChecked="True" Content="Crit" Margin="0,0,5,0" Foreground="White"/>
                                    <CheckBox x:Name="ApplySpeedCheck" IsChecked="True" Content="Speed" Margin="0,0,5,0" Foreground="White"/>
                                    <CheckBox x:Name="ChkWeaponsFromOriginal"
                                              IsChecked="True"
                                              Content="From original value"
                                              Style="{StaticResource GoldenCheckBox}"
                                              Margin="20,0,0,0"
                                              Background="#333"
                                              BorderBrush="#FFD700"
                                              Foreground="#FFD700"
                                              FontWeight="Bold"
                                              FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </TabItem>

                <!-- ARMOUR -->
                <TabItem Header="Armour">
                    <DockPanel Background="#1E1E1E">
                        <DataGrid x:Name="ArmoursGrid"
                                  ItemsSource="{Binding SelectedArmours}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  RowBackground="#2b2b2b"
                                  AlternatingRowBackground="#1f1f1f"
                                  Foreground="#f0f0f0"
                                  Background="#1e1e1e"
                                  BorderBrush="#3c3c3c"
                                  BorderThickness="1"
                                  HeadersVisibility="Column"
                                  HorizontalGridLinesBrush="#3c3c3c"
                                  VerticalGridLinesBrush="#3c3c3c"
                                  FontSize="13"
                                  Margin="5"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  DockPanel.Dock="Top"
                                  Height="520">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333" />
                                    <Setter Property="Foreground" Value="#ddd" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="BorderBrush" Value="#444" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Def" Binding="{Binding Def}" Width="80" />
                                <DataGridTextColumn Header="Prot" Binding="{Binding Prot}" Width="80" />
                                <DataGridTextColumn Header="Hp" Binding="{Binding Hp}" Width="80" />
                                <DataGridTextColumn Header="Spd" Binding="{Binding Spd}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border DockPanel.Dock="Bottom"
                                Background="#2C2C2C"
                                Padding="12"
                                Margin="10,0,10,10"
                                BorderBrush="#FFD700"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="Tab options" FontWeight="Bold" Foreground="#FFD700" Margin="0,0,0,6" FontSize="14"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ArmourPercentBox" Width="60" Text="25" Background="#2d2d2d" Foreground="White" BorderBrush="#555" HorizontalContentAlignment="Center"/>
                                    <Button Content="Apply %"
                                            Margin="5,0,10,0"
                                            Padding="6"
                                            Background="#444"
                                            Foreground="White"
                                            BorderBrush="#777"
                                            Click="ApplyArmourTabPercent_Click"/>
                                    <CheckBox x:Name="ApplyHpCheck" IsChecked="True" Content="Hp" Margin="0,0,5,0" Foreground="White"/>
                                    <CheckBox x:Name="ApplyDefCheck" IsChecked="True" Content="Def" Margin="0,0,5,0" Foreground="White"/>
                                    <CheckBox x:Name="ChkArmoursFromOriginal"
                                              IsChecked="True"
                                              Content="From original value"
                                              Style="{StaticResource GoldenCheckBox}"
                                              Margin="20,0,0,0"
                                              Background="#333"
                                              BorderBrush="#FFD700"
                                              Foreground="#FFD700"
                                              FontWeight="Bold"
                                              FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
